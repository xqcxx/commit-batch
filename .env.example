REACTIVE_LASNA_RPC_URL=https://lasna-rpc.rnk.dev/
PRIVATE_KEY=
# Etherscan-compatible API key used by forge script --verify for Uniscan.
ETHERSCAN_API_KEY=
POOL_MANAGER=
CALLBACK_PROXY=
# Reactive replaces the callback's first address argument with the Lasna RSC deployer's ReactVM ID.
EXPECTED_RVM_ID=
ORIGIN_CHAIN_ID=1301
DESTINATION_CHAIN_ID=1301
COMMIT_BATCH=
COMMIT_BATCH_ROUTER=
COMMIT_BATCH_HOOK=
CALLBACK_GAS_LIMIT=700000
SQRT_PRICE_LIMIT_X96=4295128740
# Native lREACT sent to the payable RSC constructor for its initial subscription.
RSC_DEPLOYMENT_VALUE=10000000000000000
# Canonical demonstration operator settings. Use separate, low-value Alice and Bob wallets.
DEMO_WETH=
DEMO_USDC=
OPERATOR_PRIVATE_KEY=
ALICE_PRIVATE_KEY=
BOB_PRIVATE_KEY=
ALICE_SALT=
BOB_SALT=
DEMO_BATCH_ID=
DEMO_COMMIT_DURATION=180
DEMO_REVEAL_DURATION=180
